default_platform(:ios)

platform :ios do
  lane :ensure_asc_app do
    api_key = app_store_connect_api_key(
      key_id: "45TX469F25",
      issuer_id: "69a6de7b-ed28-47e3-e053-5b8c7c11a4d1",
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_45TX469F25.p8"),
      duration: 1200,
      in_house: false
    )
    Spaceship::ConnectAPI.token = api_key

    bundle_id = "co.haam.anpusfeather"
    app = Spaceship::ConnectAPI::App.find(bundle_id)
    if app
      UI.success("ASC app already exists: #{app.name} (#{app.id})")
    else
      UI.message("Creating ASC app via Spaceship...")
      begin
        app = Spaceship::ConnectAPI::App.create(
          name: "Anpus Feather",
          version_string: "2.0",
          sku: "haam-anpus-feather-ios",
          primary_locale: "en-US",
          bundle_id: bundle_id,
          platforms: ["IOS"]
        )
        UI.success("Created ASC app: #{app.name} (#{app.id})")
      rescue => e
        UI.error("Create failed: #{e.message}")
        # Fallback: try S4QR key
        api_key2 = app_store_connect_api_key(
          key_id: "S4QR30J5JUBM",
          issuer_id: "69a6de7b-ed28-47e3-e053-5b8c7c11a4d1",
          key_filepath: File.expand_path("~/.appstoreconnect/private_keys/ApiKey_S4QR30J5JUBM.p8"),
          duration: 1200,
          in_house: false
        )
        Spaceship::ConnectAPI.token = api_key2
        begin
          app = Spaceship::ConnectAPI::App.create(
            name: "Anpus Feather",
            version_string: "2.0",
            sku: "haam-anpus-feather-ios",
            primary_locale: "en-US",
            bundle_id: bundle_id,
            platforms: ["IOS"]
          )
          UI.success("Created with upload key: #{app.name} (#{app.id})")
        rescue => e2
          UI.user_error!("Could not create ASC app automatically.\nCreate it manually at https://appstoreconnect.apple.com/apps/new\nName: Anpus Feather\nBundle ID: co.haam.anpusfeather\nSKU: haam-anpus-feather-ios\nThen re-run.\nErrors: #{e.message} / #{e2.message}")
        end
      end
    end

    groups = Spaceship::ConnectAPI.get_beta_groups(filter: { app: app.id }).to_a rescue []
    # Spaceship may return a response object
    group_list = if groups.respond_to?(:data)
      groups.data
    else
      Array(groups)
    end
    internal = group_list.find { |g| g.name == "Internal Testers" }
    unless internal
      UI.message('Creating "Internal Testers" beta group...')
      internal = Spaceship::ConnectAPI.create_beta_group(
        app_id: app.id,
        group_name: "Internal Testers",
        is_internal_group: true,
        has_access_to_all_builds: true
      )
    end
    UI.success("Beta group: #{internal.name} (#{internal.id})")
    UI.message("APPLE_ID=#{app.id}")
    UI.message("BETA_GROUP_ID=#{internal.id}")
  end
end
